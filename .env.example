# MongoDB Atlas connection string (Atlas → Connect → Drivers)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=jobhunt
# Password you type on the login page
APP_PASSWORD=choose-a-strong-password
# Random strings, 16+ characters (generate: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))")
AUTH_SECRET=
CRON_SECRET=
# Optional: Pune office jobs, free key from https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
